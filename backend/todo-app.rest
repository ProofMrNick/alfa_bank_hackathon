@baseUrl = http://localhost:5003/api
@token = {{login.response.body.token}}

### ==========================================
### 1. HEALTH - Проверка работоспособности сервера
### ==========================================

### 1.1. Проверка сервера
GET {{baseUrl}}/health


### ==========================================
### 2. PRODUCTS - Публичный список кредитов
### ==========================================

### 2.1. Получить все кредитные продукты
GET {{baseUrl}}/products


### ==========================================
### 3. AUTH - Регистрация и авторизация
### ==========================================

### 3.1. Регистрация клиента
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "client@test.local",
  "password": "password123",
  "email": "client@test.local",
  "inn": "7700000001",
  "companyName": "ИП Клиентов И.И."
}

### 3.2. Логин клиента (токен сохранится в переменную @token)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "client@test.local",
  "password": "password123"
}

### 3.3. Регистрация менеджера (для тестирования bank эндпоинтов)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "manager@test.local",
  "password": "manager123",
  "email": "manager@test.local",
  "inn": "7700000002",
  "companyName": "Альфа-Банк"
}

### 3.4. Логин менеджера
# @name loginManager
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "employee",
  "password": "12345678"
}


### ==========================================
### 4. CLIENT - Эндпоинты для клиента
### ==========================================

### 4.1. Дашборд клиента
GET {{baseUrl}}/client/dashboard
Authorization: {{token}}

### 4.2. Рекомендации кредитов
GET {{baseUrl}}/client/recommendations
Authorization: {{token}}


### ==========================================
### 5. APPLICATIONS (CLIENT) - Работа с заявками
### ==========================================

### 5.1. Получить все заявки текущего клиента
GET {{baseUrl}}/applications
Authorization: {{token}}

### 5.2. Создать/получить заявку с local_id = 1
GET {{baseUrl}}/applications/1
Authorization: {{token}}

### 5.3. Подать заявку (local_id = 1, loan_id = 1 из products)
POST {{baseUrl}}/applications/1/submit
Authorization: {{token}}
Content-Type: application/json

{
  "loan_id": 1,
  "loan_sum": 500000,
  "loan_interest": 12.5,
  "loan_duration": 60
}

### 5.4. История изменений заявки (local_id = 1)
GET {{baseUrl}}/applications/1/history
Authorization: {{token}}


### ==========================================
### 6. BANK (EMPLOYEE) - Эндпоинты для сотрудника банка
### ==========================================

### 6.1. Получить все заявки (требует роль MANAGER/EMPLOYEE)
GET {{baseUrl}}/bank/applications
Authorization: {{loginManager.response.body.token}}

### 6.2. Получить конкретную заявку по global_id (например, 1)
GET {{baseUrl}}/bank/applications/1
Authorization: {{loginManager.response.body.token}}

### 6.3. Одобрить заявку
POST {{baseUrl}}/bank/applications/1/decision
Authorization: {{loginManager.response.body.token}}
Content-Type: application/json

{
  "type": "APPROVE",
  "approvedAmount": 500000,
  "approvedTermMonths": 60,
  "approvedRate": 12.5,
  "missingFields": null,
  "reason": null,
  "comment": "Заявка одобрена"
}

### 6.4. Отклонить заявку (пример для local_id = 2)
POST {{baseUrl}}/bank/applications/2/decision
Authorization: {{loginManager.response.body.token}}
Content-Type: application/json

{
  "type": "DECLINE",
  "approvedAmount": null,
  "approvedTermMonths": null,
  "approvedRate": null,
  "missingFields": "income_proof",
  "reason": "Недостаточный доход",
  "comment": "Требуется подтверждение дохода"
}

### 6.5. Запросить недостающие документы
POST {{baseUrl}}/bank/applications/1/decision
Authorization: {{loginManager.response.body.token}}
Content-Type: application/json

{
  "type": "REQUEST_INFO",
  "approvedAmount": null,
  "approvedTermMonths": null,
  "approvedRate": null,
  "missingFields": "passport,snils",
  "reason": null,
  "comment": "Необходимо загрузить паспорт и СНИЛС"
}